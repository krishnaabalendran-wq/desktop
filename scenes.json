{
  "scenes": [
    {
      "id": "morning-briefing",
      "name": "Morning briefing",
      "color": "#17492b",
      "triggers": [
        {
          "type": "time",
          "at": "08:30",
          "days": ["Mon", "Tue", "Wed", "Thu", "Fri"],
          "reason": "Start-of-day briefing"
        }
      ],
      "steps": [
        { "type": "open_link", "url": "https://calendar.google.com" },
        { "type": "open_link", "url": "https://mail.google.com" },
        { "type": "open_app", "app": "Slack" },
        { "type": "set_volume", "percent": 25 },
        { "type": "send_notification", "title": "Morning briefing", "text": "Calendar, email, and Slack are ready." },
        { "type": "message", "text": "Morning briefing ready" }
      ]
    },
    {
      "id": "standup-prep",
      "name": "Standup prep",
      "color": "#2d5a4e",
      "triggers": [
        {
          "type": "time",
          "at": "09:10",
          "days": ["Mon", "Tue", "Wed", "Thu", "Fri"],
          "reason": "Standup is coming up"
        }
      ],
      "steps": [
        { "type": "open_link", "url": "https://calendar.google.com" },
        { "type": "open_link", "url": "https://github.com" },
        { "type": "open_app", "app": "Slack" },
        { "type": "set_volume", "percent": 45 },
        { "type": "message", "text": "Standup prep ready" }
      ]
    },
    {
      "id": "coding-mode",
      "name": "Coding mode",
      "color": "#2f4a5a",
      "triggers": [
        {
          "type": "app_focused",
          "app": "Terminal",
          "seconds": 5,
          "reason": "Terminal is open"
        }
      ],
      "steps": [
        { "type": "open_app", "app": "Visual Studio Code" },
        { "type": "open_link", "url": "https://github.com" },
        { "type": "set_volume", "percent": 20 },
        { "type": "message", "text": "Development environment ready" }
      ]
    },
    {
      "id": "focus-mode",
      "name": "Focus mode",
      "color": "#5a4410",
      "triggers": [
        {
          "type": "app_focused",
          "app": "Visual Studio Code",
          "seconds": 10,
          "reason": "You look like you're starting focused work"
        }
      ],
      "steps": [
        { "type": "set_volume", "percent": 10 },
        { "type": "open_app", "app": "Spotify" },
        { "type": "wait", "seconds": 3 },
        { "type": "message", "text": "Focus mode on" }
      ]
    },
    {
      "id": "documentation-mode",
      "name": "Documentation mode",
      "color": "#3d5a4e",
      "triggers": [
        {
          "type": "app_focused",
          "app": "Obsidian",
          "seconds": 10,
          "reason": "Notes app is open"
        }
      ],
      "steps": [
        { "type": "open_app", "app": "Google Chrome" },
        { "type": "open_path", "path": "~/Documents/Obsidian" },
        { "type": "set_volume", "percent": 15 },
        { "type": "message", "text": "Documentation workspace ready" }
      ]
    },
    {
      "id": "call-mode",
      "name": "Call mode",
      "color": "#1b3a6b",
      "triggers": [
        {
          "type": "app_focused",
          "app": "Zoom",
          "seconds": 10,
          "reason": "Zoom is open"
        }
      ],
      "steps": [
        { "type": "set_volume", "percent": 50 },
        { "type": "open_link", "url": "https://calendar.google.com" },
        { "type": "send_notification", "title": "Call mode", "text": "Check your mic and camera." },
        { "type": "message", "text": "Call mode ready" }
      ]
    },
    {
      "id": "presentation-mode",
      "name": "Presentation mode",
      "color": "#1b3a6b",
      "triggers": [
        {
          "type": "app_focused",
          "app": "Keynote",
          "seconds": 10,
          "reason": "Presentation app is open"
        }
      ],
      "steps": [
        { "type": "set_volume", "percent": 40 },
        { "type": "open_app", "app": "Google Chrome" },
        { "type": "wait", "seconds": 2 },
        { "type": "message", "text": "Presentation mode ready" }
      ]
    },
    {
      "id": "writing-sprint",
      "name": "Writing sprint",
      "color": "#4a4a2b",
      "triggers": [
        {
          "type": "app_focused",
          "app": "Obsidian",
          "seconds": 20,
          "reason": "Writing time"
        }
      ],
      "steps": [
        { "type": "set_volume", "percent": 10 },
        { "type": "open_app", "app": "Spotify" },
        { "type": "wait", "seconds": 3 },
        { "type": "create_folder", "parent": "~/Documents/Writing", "name": "Writing sprint - {date}" },
        { "type": "message", "text": "Writing sprint started" }
      ]
    },
    {
      "id": "learning-block",
      "name": "Learning block",
      "color": "#3d3d5c",
      "triggers": [
        {
          "type": "time",
          "at": "14:00",
          "days": ["Mon", "Tue", "Wed", "Thu", "Fri"],
          "reason": "Learning block"
        }
      ],
      "steps": [
        { "type": "open_link", "url": "https://www.youtube.com" },
        { "type": "open_link", "url": "https://gemini.google.com" },
        { "type": "web_search", "query": "best productivity techniques {date}" },
        { "type": "set_volume", "percent": 25 },
        { "type": "message", "text": "Learning block ready" }
      ]
    },
    {
      "id": "lunch-reminder",
      "name": "Lunch reminder",
      "color": "#5a2f3f",
      "triggers": [
        {
          "type": "time",
          "at": "11:50",
          "days": ["Mon", "Tue", "Wed", "Thu", "Fri"],
          "reason": "Lunch is coming up"
        }
      ],
      "steps": [
        { "type": "set_volume", "percent": 0 },
        { "type": "open_link", "url": "https://www.google.com/maps" },
        { "type": "send_notification", "title": "Lunch", "text": "Time to take a break." },
        { "type": "message", "text": "Lunch break" }
      ]
    },
    {
      "id": "long-break",
      "name": "Long break",
      "color": "#3b4a6b",
      "triggers": [
        {
          "type": "idle",
          "minutes": 50,
          "reason": "You've been working for a while"
        }
      ],
      "steps": [
        { "type": "set_volume", "percent": 30 },
        { "type": "open_link", "url": "https://www.youtube.com" },
        { "type": "message", "text": "Break started" }
      ]
    },
    {
      "id": "back-to-work",
      "name": "Back to work",
      "color": "#4a5a2b",
      "triggers": [
        {
          "type": "idle",
          "minutes": 10,
          "reason": "You stepped away"
        }
      ],
      "steps": [
        { "type": "set_volume", "percent": 20 },
        { "type": "open_link", "url": "https://calendar.google.com" },
        { "type": "message", "text": "Back to work" }
      ]
    },
    {
      "id": "invoice-day",
      "name": "Invoice day",
      "color": "#5a4a2b",
      "triggers": [
        {
          "type": "time",
          "at": "10:00",
          "days": ["Fri"],
          "reason": "Weekly admin time"
        }
      ],
      "steps": [
        { "type": "open_path", "path": "~/Documents/Invoices" },
        { "type": "open_file", "path": "~/Documents/Invoices/invoice-template.pdf" },
        { "type": "open_link", "url": "https://www.google.com" },
        { "type": "set_volume", "percent": 15 },
        { "type": "message", "text": "Invoice workspace ready" }
      ]
    },
    {
      "id": "project-archive",
      "name": "Project archive",
      "color": "#2b4a5a",
      "triggers": [
        {
          "type": "time",
          "at": "16:00",
          "days": ["Fri"],
          "reason": "Weekly project cleanup"
        }
      ],
      "steps": [
        { "type": "create_folder", "parent": "~/Documents/Archives", "name": "Archive - {date}" },
        { "type": "open_path", "path": "~/Documents/Archives" },
        { "type": "send_notification", "title": "Project archive", "text": "Archive folder created." },
        { "type": "message", "text": "Archive folder ready" }
      ]
    },
    {
      "id": "weekly-planning",
      "name": "Weekly planning",
      "color": "#3d3d5c",
      "triggers": [
        {
          "type": "time",
          "at": "15:30",
          "days": ["Fri"],
          "reason": "Weekly planning time"
        }
      ],
      "steps": [
        { "type": "open_link", "url": "https://calendar.google.com" },
        { "type": "open_link", "url": "https://github.com" },
        { "type": "open_app", "app": "Obsidian" },
        { "type": "set_volume", "percent": 20 },
        { "type": "message", "text": "Weekly planning mode" }
      ]
    },
    {
      "id": "end-of-day",
      "name": "End of day",
      "color": "#4a2a5a",
      "triggers": [
        {
          "type": "time",
          "at": "16:50",
          "days": ["Mon", "Tue", "Wed", "Thu", "Fri"],
          "reason": "Time to wrap up"
        }
      ],
      "steps": [
        { "type": "set_volume", "percent": 0 },
        {
          "type": "run_command",
          "command": "osascript -e 'tell application \"Slack\" to quit'",
          "timeout": 10
        },
        { "type": "wait", "seconds": 5 },
        { "type": "send_notification", "title": "End of day", "text": "Workday complete. Going home." },
        { "type": "sleep_mac" }
      ]
    }
  ]
}